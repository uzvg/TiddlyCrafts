 /* ==========================================================================
    TiddlyFlashcards
    ==========================================================================

    HTML structure of tf-reveal-editor

    .tf-card-container
      .tf-card-id
      .tf-card-btns
        span.tc-keyboard
          .tf-fields-container[data-tf-mode="display|edit|create"]
            label.tf-field-name
            .tf-field-value[data-input-index]

    ========================================================================== */


/* ==========================================================================
   Card
   ========================================================================== */

.tf-card-container {
  /* ------------------------------------------------------------------------
     Design tokens
     ------------------------------------------------------------------------ */

  /* Accent is used for emphasis, not for the card surface. */
  --tf-accent: var(--tpc-primary);

  /* Card surface is derived from the TiddlyWiki background layers. */
  --tf-surface:
    color-mix(
      in srgb,
      var(--tpc-background) 65%,
      var(--tpc-page-background)
    );

  --tf-surface-hover:
    color-mix(
      in srgb,
      var(--tpc-background) 55%,
      var(--tpc-page-background)
    );

  /* Border */
  --tf-border:
    color-mix(
      in srgb,
      var(--tf-accent) 30%,
      transparent
    );

  --tf-border-hover:
    color-mix(
      in srgb,
      var(--tf-accent) 65%,
      transparent
    );

  /* Glow */
  --tf-glow:
    color-mix(
      in srgb,
      var(--tf-accent) 12%,
      transparent
    );

  --tf-glow-hover:
    color-mix(
      in srgb,
      var(--tf-accent) 24%,
      transparent
    );

  /* Animation */
  --tf-transition: 180ms ease;


  /* ------------------------------------------------------------------------
     Layout
     ------------------------------------------------------------------------ */

  display: grid;

  grid-template-columns: auto 1fr;
  grid-template-rows: 2em 1fr;

  grid-template-areas:
    "id button"
    "field field";

  /*
   * Prevent cards from becoming excessively wide while still allowing
   * them to fill narrow containers.
   */
  width: min(100%, 44rem);


  /* ------------------------------------------------------------------------
     Surface
     ------------------------------------------------------------------------ */

  border: 1px solid var(--tf-border);
  border-inline-start: 3px solid var(--tf-accent);
  border-radius: 4px;

  background: var(--tf-surface);

  box-shadow:
    0 0 5px var(--tf-glow);

  transition:
    background-color var(--tf-transition),
    border-color var(--tf-transition),
    box-shadow var(--tf-transition),
    transform var(--tf-transition);


  /* ------------------------------------------------------------------------
     Hover
     ------------------------------------------------------------------------ */

  &:hover {
    background: var(--tf-surface-hover);

    border-color: var(--tf-border-hover);

    box-shadow:
      0 2px 8px var(--tf-glow),
      0 0 12px var(--tf-glow-hover);

    transform: translateY(-1px);
  }


  /* ------------------------------------------------------------------------
     Suspended
     ------------------------------------------------------------------------ */

  &[data-card-status="suspend"] {
    --tf-accent:
      color-mix(
        in srgb,
        var(--tpc-foreground) 38%,
        transparent
      );

    --tf-border:
      color-mix(
        in srgb,
        var(--tpc-foreground) 16%,
        transparent
      );

    --tf-glow: transparent;
    --tf-glow-hover: transparent;

    opacity: .65;

    box-shadow: none;


    &:hover {
      opacity: .8;

      transform: none;

      box-shadow: none;

      border-color:
        color-mix(
          in srgb,
          var(--tpc-foreground) 28%,
          transparent
        );
    }
  }


  /* ------------------------------------------------------------------------
     Unsuspended
     ------------------------------------------------------------------------ */

  &[data-card-status="unsuspend"] {
    opacity: 1;
  }


  /* ------------------------------------------------------------------------
     Internal TiddlyWiki wrappers
     ------------------------------------------------------------------------ */

  .tc-keyboard,
  .tc-eventcatcher {
    display: contents;
  }
}


/* ==========================================================================
   Card ID
   ========================================================================== */

.tf-card-id {
  grid-area: id;

  display: grid;
  align-items: center;

  padding-inline-start: .6em;

  font-family: monospace;
  font-size: .8em;
  letter-spacing: 1px;

  color:
    color-mix(
      in srgb,
      var(--tpc-foreground) 50%,
      transparent
    );

  transition:
    color var(--tf-transition);


  .tf-card-container:hover & {
    color:
      color-mix(
        in srgb,
        var(--tf-accent) 70%,
        var(--tpc-foreground)
      );
  }
}


/* ==========================================================================
   Card buttons
   ========================================================================== */

.tf-card-btns {
  grid-area: button;

  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;

  gap: .35em;
  padding-inline-end: .5em;


  /*
   * Buttons remain in the layout but are visually hidden until the card
   * is hovered.
   */
  .tc-btn-invisible {
    opacity: 0;

    transform:
      translateY(-2px)
      scale(.92);

    pointer-events: none;

    transition:
      opacity var(--tf-transition),
      transform var(--tf-transition);
  }


  /*
   * Reveal controls when hovering the card.
   */
  .tf-card-container:hover & .tc-btn-invisible {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);

    pointer-events: auto;
  }
}


/* ==========================================================================
   Fields container
   ========================================================================== */

.tf-fields-container {
  grid-area: field;

  display: grid;
  grid-template-columns: auto 1fr;


  /* ------------------------------------------------------------------------
     Display
     ------------------------------------------------------------------------ */

  &[data-tf-mode="display"] {

    .tf-field-name,
    .tf-field-value {
      border-block-start:
        1px dotted
        color-mix(
          in srgb,
          var(--tf-accent) 25%,
          transparent
        );
    }


    .tf-field-name {
      border-inline-end:
        1px dotted
        color-mix(
          in srgb,
          var(--tf-accent) 25%,
          transparent
        );
    }
  }


  /* ------------------------------------------------------------------------
     Create
     ------------------------------------------------------------------------ */

  &[data-tf-mode="create"] {
    margin: .35em;
    padding: .7em;

    border-radius: 3px;

    background:
      color-mix(
        in srgb,
        var(--tpc-background) 50%,
        var(--tpc-page-background)
      );

    box-shadow:
      inset 0 0 0 1px
      color-mix(
        in srgb,
        var(--tf-accent) 12%,
        transparent
      );


    .tf-field-name {
      color: var(--tf-accent);
    }
  }


  /* ------------------------------------------------------------------------
     Edit
     ------------------------------------------------------------------------ */

  &[data-tf-mode="edit"] {
    background:
      color-mix(
        in srgb,
        var(--tpc-background) 55%,
        var(--tpc-page-background)
      );


    .tf-field-name {
      color:
        color-mix(
          in srgb,
          var(--tf-accent) 75%,
          var(--tpc-foreground)
        );
    }
  }
}


/* ==========================================================================
   Field name
   ========================================================================== */

.tf-field-name {
  display: grid;
  justify-items: end;
  align-items: center;

  padding-inline: .5em;

  font-family: monospace;
  font-size: .8em;
  font-weight: bold;
  letter-spacing: 1px;
  text-transform: uppercase;

  color:
    color-mix(
      in srgb,
      var(--tpc-foreground) 58%,
      transparent
    );

  transition:
    color var(--tf-transition),
    background-color var(--tf-transition),
    border-color var(--tf-transition);
}


/* ==========================================================================
   Field value
   ========================================================================== */

.tf-field-value {
  display: grid;
  align-items: center;

  min-width: 0;

  padding-inline-start: .5em;

  transition:
    color var(--tf-transition),
    background-color var(--tf-transition),
    border-color var(--tf-transition);
}


/* ==========================================================================
   Card list
   ========================================================================== */

.tf-card-list {
  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 1em;
}

.tf-list-paginator {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-inline: auto;
}

.tf-list-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  
  .tf-page-indicator {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    padding-inline-start: .5em;

    .tf-current-page {
      color: var(--tpc-primary);
      &::before {
        content: "🗏 "
      }
    }
  }

  .tf-header-btns {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-inline-end: 1em;
  }
}