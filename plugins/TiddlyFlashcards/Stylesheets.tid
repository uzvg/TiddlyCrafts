title: $:/plugins/uzvg/TiddlyFlashcards/styles
tags: $:/tags/Stylesheet
code-body: yes

.twks-flashcards-creator {
	display: flex;
	flex-direction: column;
	background: <<color page-background>>;
	gap: .5em;
	padding: 1em;
	justify-content: space-between;
}

.twks-flashcards-creator > .tc-flex {
	align-items: center;
	gap: .5em;
}
.twks-flashcards-creator label {
	color: <<color yellow>>;
	width: 3em;
}

<!-- ------------------------------- -->

.twks-flashcards-container {
	display: flex;
	flex-direction: column;
	background: <<color page-background>>;
	gap: 1em;
	padding: 1em;
	justify-content: space-around;
}

.twks-flashcards-container label {
	width: 2em;
	color: <<color yellow>>;
	text-align: center;
}

.twks-flashcards-container input[type="text"] {
	border-style: none;
	line-height: 1.5em;
	height: 1.5em;
	border: none;
	width: -webkit-fill-available;
}

.tr-ritem {
	display: flex;
	flex-direction: row;
}

.tr-ritem .tc-keyboard {
	width: -webkit-fill-available;
}

.tr-ritem .input[type="text"] {
	width: -webkit-fill-available;
}