 /* ==========================================================================
    TiddlyFlashcards
    ==========================================================================

    HTML structure of tf-reveal-editor

    .tf-card-container[tf-card-index]
      .tf-card-id
      .tf-card-btns
        span.tc-keyboard
          .tf-fields-container[data-tf-mode="display|edit|create"]
            label.tf-field-name
            .tf-field-value[data-input-index]

    ========================================================================== */


/* ==========================================================================
   Card
   ========================================================================== */

.tf-card-container {
  /* ------------------------------------------------------------------------
     Design tokens
     ------------------------------------------------------------------------ */

  /* Accent is used for emphasis, not for the card surface. */
  --tf-accent: var(--tpc-primary);

  /* Card surface is derived from the TiddlyWiki background layers. */
  --tf-surface: color-mix(
    in oklab,
    var(--tpc-background) 65%,
    var(--tpc-page-background) 35%
  );

  --tf-surface-hover: color-mix(
    in oklab,
    var(--tpc-background) 55%,
    var(--tpc-page-background) 45%
  );

  /* Border */
  --tf-border: color-mix(in oklab, var(--tf-accent) 30%, transparent);

  --tf-border-hover: color-mix(in oklab, var(--tf-accent) 65%, transparent);

  /* Glow */
  --tf-glow: color-mix(in oklab, var(--tf-accent) 12%, transparent);

  --tf-glow-hover: color-mix(in oklab, var(--tf-accent) 24%, transparent);

  /* Animation */
  --tf-transition: 300ms ease;

  /* ------------------------------------------------------------------------
     Layout
     ------------------------------------------------------------------------ */

  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: 2em 1fr;

  grid-template-areas:
    "id button"
    "field field";

  align-items: center;
  /*
   * Prevent cards from becoming excessively wide while still allowing
   * them to fill narrow containers.
   */
  width: min(100%, 54em);

  padding: 0.5em;

  /* ------------------------------------------------------------------------
     Surface
     ------------------------------------------------------------------------ */

  border: 1px solid var(--tf-border);
  border-inline-start: 3px solid var(--tf-accent);
  border-radius: 4px;

  background: var(--tf-surface);

  box-shadow: 0 0 5px var(--tf-glow);

  transition:
    background-color var(--tf-transition),
    border-color var(--tf-transition),
    box-shadow var(--tf-transition),
    transform var(--tf-transition);

  /* ------------------------------------------------------------------------
     Hover
     ------------------------------------------------------------------------ */

  &:hover {
    background: var(--tf-surface-hover);

    border-color: var(--tf-border-hover);

    box-shadow:
      0 2px 8px var(--tf-glow),
      0 0 12px var(--tf-glow-hover);

    transform: translateY(-1px);
  }

  &:hover .tf-cloze {
    filter: none;
    background: color-mix(in oklab, currentColor 5%, transparent);
    border: 1px solid var(--tf-border);
    border-radius: 2px;
  }

  /* ------------------------------------------------------------------------
     Suspended
     ------------------------------------------------------------------------ */

  &[data-card-status="suspend"] {
    --tf-accent: color-mix(in oklab, var(--tpc-foreground) 38%, transparent);

    --tf-border: color-mix(in oklab, var(--tpc-foreground) 16%, transparent);

    --tf-glow: transparent;
    --tf-glow-hover: transparent;

    opacity: 0.65;

    box-shadow: none;

    &:hover {
      opacity: 0.8;

      transform: none;

      box-shadow: none;

      border-color: color-mix(in oklab, var(--tpc-foreground) 28%, transparent);
    }
  }

  /* ------------------------------------------------------------------------
     Unsuspended
     ------------------------------------------------------------------------ */

  &[data-card-status="unsuspend"] {
    opacity: 1;
  }

  /* ------------------------------------------------------------------------
     Internal TiddlyWiki wrappers
     ------------------------------------------------------------------------ */

  .tc-keyboard,
  .tc-eventcatcher {
    display: contents;
  }
}

/* ==========================================================================
   Card ID
   ========================================================================== */

.tf-card-id {
  grid-area: id;

  padding-inline-start: 0.6em;

  font-family: monospace;
  font-size: 0.8em;
  letter-spacing: 1px;

  color: color-mix(in oklab, var(--tpc-foreground) 50%, transparent);

  transition: color var(--tf-transition);

  &::before {
    content: "#";
  }

  .tf-card-container:hover & {
    color: color-mix(in oklab, var(--tpc-foreground) 80%, transparent);
  }
}

/* ==========================================================================
   Card buttons
   ========================================================================== */

.tf-card-btns {
  grid-area: button;

  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;

  gap: 0.35em;
  padding-inline-end: 0.5em;

  /*
   * Buttons remain in the layout but are visually hidden until the card
   * is hovered.
   */
  button {
    background: color-mix(in oklab, var(--tf-accent) 5%, transparent);
    border: 1px solid var(--tf-border);
    border-radius: 2px;
    padding: 1px 0.5em;

    opacity: 0;

    transform: translateX(6px);

    pointer-events: none;

    transition:
      opacity var(--tf-transition),
      transform var(--tf-transition);

    & svg.tc-image-button {
      width: .8em;
      height: .8em;
      fill: var(--tf-accent);
    }
  }

  /*
   * Reveal controls when hovering the card.
   */
  .tf-card-container:hover & button {
    opacity: 1;

    transform: translateX(0);

    pointer-events: auto;
  }

  .tf-card-container:hover & button:hover {
    box-shadow:
      0 2px 8px var(--tf-glow),
      0 0 12px var(--tf-glow-hover);
  }
}

/* ==========================================================================
   Fields container
   ========================================================================== */

.tf-fields-container {
  grid-area: field;

  display: grid;
  grid-template-columns: auto 1fr;

  /* ------------------------------------------------------------------------
     Display
     ------------------------------------------------------------------------ */

  &[data-tf-mode="display"] {
    .tf-field-name,
    .tf-field-value {
      border-block-start: 2px dotted
        color-mix(in oklab, var(--tf-accent) 25%, transparent);
    }

    .tf-field-name {
      border-inline-end: 2px dotted
        color-mix(in oklab, var(--tf-accent) 25%, transparent);
    }
  }

  /* ------------------------------------------------------------------------
     Create
     ------------------------------------------------------------------------ */

  &[data-tf-mode="create"] {
    margin: 0.35em;
    padding: 0.7em;

    border-radius: 3px;

    background: color-mix(
      in oklab,
      var(--tpc-background) 50%,
      var(--tpc-page-background)
    );

    box-shadow: inset 0 0 0 1px
      color-mix(in oklab, var(--tf-accent) 12%, transparent);

    .tf-field-name {
      color: color-mix(in oklab, var(--tpc-primary) 100%, transparent);
    }
  }

  /* ------------------------------------------------------------------------
     Edit
     ------------------------------------------------------------------------ */

  &[data-tf-mode="edit"] {
    background: color-mix(
      in oklab,
      var(--tpc-background) 55%,
      var(--tpc-page-background)
    );

    .tf-field-name {
      color: color-mix(in oklab, var(--tf-accent) 75%, var(--tpc-foreground));
    }
  }
}

/* ==========================================================================
   Field name
   ========================================================================== */

.tf-field-name {
  display: grid;
  justify-items: end;
  align-items: center;

  padding-inline: 1em;

  font-family: monospace;
  font-size: 0.8em;
  font-weight: 500;
  letter-spacing: 1px;
  text-transform: uppercase;

  color: color-mix(in oklab, var(--tpc-primary) 60%, transparent);

  transition:
    color var(--tf-transition),
    background-color var(--tf-transition),
    border-color var(--tf-transition);

  .tf-card-container:hover & {
    color: color-mix(in oklab, var(--tpc-primary) 100%, transparent);
  }
}

/* ==========================================================================
   Field value
   ========================================================================== */

.tf-field-value {
  display: grid;
  align-items: center;

  min-width: 0;

  padding-inline: 1em;

  transition:
    color var(--tf-transition),
    background-color var(--tf-transition),
    border-color var(--tf-transition);
}

/* ==========================================================================
   Card list
   ========================================================================== */

.tf-card-list {
  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 1em;
}

.tf-list-paginator {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-inline: auto;
  height: 2.5em;
  align-items: center;
  width: min(100%, 54em);
  margin-top: 0.5em;
}

.tf-list-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  height: 2.5em;
  align-items: flex-start;

  .tf-page-indicator {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    padding-inline-start: 0.5em;

    .tf-current-page {
      color: var(--tpc-primary);
      font-weight: bold;
      &::before {
        content: "🗏 ";
        color: var(--tpc-foreground);
      }
    }

    .tf-cards-count::before {
      content: "▪";
    }
  }

  .tf-header-btns {
    opacity: 0;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-inline-end: 1em;
    gap: 0.5em;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    .tf-list-header:hover & {
      opacity: 1;
      transform: translateX(-6px);
    }
  }
}

.tf-cloze {
  filter: blur(4px);
  user-select: none;
  margin-inline: 0.1em;
  transition:
    filter 0.3s ease,
    background 0.3s ease;
}