title: $:/plugins/uzvg/TiddlyFlashcards/styles
tags: $:/tags/Stylesheet
code-body: yes
type: text/css

.tf-card-editor-container {
  display: flex;
  flex-direction: column;
  background: <<color page-background>>;
  gap: 0.5em;
  padding: 1em;
  justify-content: space-between;
}

.tf-card-editor-container > .tc-flex {
  align-items: center;
  gap: 0.5em;
}
.tf-card-editor-container label {
  color: <<color yellow>>;
  width: 3em;
}

/* =========================================================
   TiddlyFlashcards - Card List
   ========================================================= */

/* ---------------------------------------------------------
   Card
   --------------------------------------------------------- */

.tf-card-container {
  position: relative;

  width: 100%;
  max-width: 780px;
  box-sizing: border-box;

  margin: 0 auto 14px;
  padding: 28px 30px 30px;

  /*
   * Keep the card visually distinct from the page while
   * remaining compatible with arbitrary TiddlyWiki palettes.
   *
   * The card is based on page-background, with a small amount
   * of foreground mixed in to create a separate surface.
   */
  background: color-mix(
    in srgb,
    var(--tpc-page-background) 94%,
    var(--tpc-foreground)
  );

  /* background: var(--tpc-page-background); */

  border: 2px solid color-mix(in srgb, var(--tpc-foreground) 15%, transparent);

  border-radius: 9px;

  box-shadow:
    0 1px 2px color-mix(in srgb, var(--tpc-foreground) 6%, transparent),
    0 4px 12px color-mix(in srgb, var(--tpc-foreground) 5%, transparent);

  transition:
    border-color 120ms ease,
    box-shadow 120ms ease,
    transform 120ms ease;
}

/* subtle interaction */

.tf-card-container:hover {
  border-color: color-mix(in srgb, var(--tpc-foreground) 25%, transparent);

  box-shadow:
    0 2px 4px color-mix(in srgb, var(--tpc-foreground) 8%, transparent),
    0 7px 18px color-mix(in srgb, var(--tpc-foreground) 7%, transparent);

  transform: translateY(-1px);
}

/* ---------------------------------------------------------
   Card ID
   --------------------------------------------------------- */

.tf-card-id {
  position: absolute;

  top: 10px;
  left: 13px;

  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  font-size: 9px;
  line-height: 1;

  color: var(--tpc-very-muted-foreground);

  user-select: none;
  pointer-events: none;
}

/* ---------------------------------------------------------
   Action buttons
   --------------------------------------------------------- */

.tf-card-btns {
  position: absolute;

  top: 6px;
  right: 8px;

  display: flex;
  align-items: center;
  gap: 2px;

  opacity: 0;
  transform: translateY(-2px);

  pointer-events: none;

  transition:
    opacity 120ms ease,
    transform 120ms ease;
}

/*
 * Show buttons when:
 * - mouse is over the card
 * - keyboard focus is inside the card
 */

.tf-card-container:hover .tf-card-btns,
.tf-card-container:focus-within .tf-card-btns {
  opacity: 1;
  transform: translateY(0);

  pointer-events: auto;
}

/*
 * TiddlyWiki's native button class
 */

.tf-card-container .tf-card-btns .tc-btn-invisible,
.tf-card-container .tf-card-btns button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  width: 28px;
  height: 28px;

  padding: 0;
  margin: 0;

  border: 0;
  border-radius: 5px;

  background: transparent;

  color: var(--tpc-tiddler-controls-foreground);

  cursor: pointer;

  transition:
    background-color 100ms ease,
    color 100ms ease;
}

.tf-card-container .tf-card-btns .tc-btn-invisible:hover,
.tf-card-container .tf-card-btns button:hover {
  background: color-mix(in srgb, var(--tpc-foreground) 8%, transparent);

  color: var(--tpc-tiddler-controls-foreground-hover);
}

.tf-card-container .tf-card-btns .tc-btn-invisible:active,
.tf-card-container .tf-card-btns button:active {
  background: color-mix(in srgb, var(--tpc-foreground) 13%, transparent);
}

/* ---------------------------------------------------------
   Fields container
   --------------------------------------------------------- */

.tf-fields-container {
  width: 100%;
}

/* ---------------------------------------------------------
   Individual field
   --------------------------------------------------------- */

.tf-card-field {
  position: relative;

  padding: 6px 0 10px;
}

/*
 * Every field after the first one gets a divider.
 */

.tf-card-field + .tf-card-field {
  margin-top: 18px;
  padding-top: 27px;

  border-top: 1px dashed
    color-mix(in srgb, var(--tpc-foreground) 20%, transparent);
}

/* ---------------------------------------------------------
   Field name
   --------------------------------------------------------- */

.tf-field-name {
  margin-bottom: 7px;

  font-size: 10px;
  font-weight: 600;
  line-height: 1.3;

  letter-spacing: 0.08em;
  text-transform: uppercase;

  color: var(--tpc-muted-foreground);
}

/* ---------------------------------------------------------
   Field value
   --------------------------------------------------------- */

.tf-field-value {
  font-size: 16px;
  line-height: 1.65;

  color: var(--tpc-foreground);

  overflow-wrap: anywhere;
}

/*
 * Give the actual content a little more visual weight
 * without making it look like a review card.
 */

.tf-card-field:first-child .tf-field-value {
  font-size: 17px;
}

/* ---------------------------------------------------------
   Card type symbol
   --------------------------------------------------------- */

/*
 * The type indicator sits on the first divider.
 *
 * Since the fields are wrapped by .tf-fields-container,
 * :nth-child(2) reliably means the second field.
 */

.tf-card-field:nth-child(2)::before {
  position: absolute;

  top: -10px;
  left: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  width: 30px;
  height: 18px;

  box-sizing: border-box;

  transform: translateX(-50%);

  /*
   * Match the card surface rather than using a fixed colour.
   */
  background: color-mix(
    in srgb,
    var(--tpc-page-background) 94%,
    var(--tpc-foreground)
  );

  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  font-size: 13px;
  line-height: 18px;

  color: var(--tpc-very-muted-foreground);

  pointer-events: none;
}

/* Basic */

.tf-card-container[data-model-name="TFBasic"]
  .tf-card-field:nth-child(2)::before {
  content: "↓";
}

/* Cloze */

.tf-card-container[data-model-name="TFCloze"]
  .tf-card-field:nth-child(2)::before {
  content: "◇";
}

/* Type */

.tf-card-container[data-model-name="TFType"]
  .tf-card-field:nth-child(2)::before {
  content: "→";
}

/* Pair */

.tf-card-container[data-model-name="TFPair"]
  .tf-card-field:nth-child(2)::before {
  content: "⇄";
}

/* Optional Pair */

.tf-card-container[data-model-name="TFOptionalPair"]
  .tf-card-field:nth-child(2)::before {
  content: "⇄·";
}

/* ---------------------------------------------------------
   Suspended card
   --------------------------------------------------------- */

.tf-card-container[data-card-status="suspend"] {
  /*
   * Suspended cards intentionally collapse toward the page
   * background instead of disappearing completely.
   */
  background: color-mix(
    in srgb,
    var(--tpc-page-background) 98%,
    var(--tpc-foreground)
  );

  border-color: color-mix(in srgb, var(--tpc-foreground) 10%, transparent);

  box-shadow: none;

  transform: none;
}

/*
 * Muted content
 */

.tf-card-container[data-card-status="suspend"] .tf-field-name {
  color: var(--tpc-very-muted-foreground);
}

.tf-card-container[data-card-status="suspend"] .tf-field-value {
  color: var(--tpc-muted-foreground);
}

.tf-card-container[data-card-status="suspend"] .tf-card-id {
  color: var(--tpc-very-muted-foreground);
}

/*
 * Don't make a suspended card "lift" on hover.
 */

.tf-card-container[data-card-status="suspend"]:hover {
  border-color: color-mix(in srgb, var(--tpc-foreground) 13%, transparent);

  box-shadow: none;

  transform: none;
}

/*
 * The divider symbol should also become quieter.
 */

.tf-card-container[data-card-status="suspend"]
  .tf-card-field:nth-child(2)::before {
  color: var(--tpc-very-muted-foreground);
}

/* ---------------------------------------------------------
   Touch devices
   --------------------------------------------------------- */

/*
 * There is no hover state on touch screens,
 * so keep the action buttons accessible.
 */

@media (hover: none), (pointer: coarse) {
  .tf-card-btns {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
}

/* ---------------------------------------------------------
   Reduced motion
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .tf-card-container,
  .tf-card-btns,
  .tf-card-btns button,
  .tf-card-btns .tc-btn-invisible {
    transition: none;
  }
}
