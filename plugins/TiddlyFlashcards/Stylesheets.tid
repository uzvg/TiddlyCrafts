title: $:/plugins/uzvg/TiddlyFlashcards/styles
tags: $:/tags/Stylesheet
code-body: yes
type: text/css

/* Html structure of tf-reveal-editor
.tf-card-container
  .tf-card-id
  .tf-card-btns
    span.tc-keyboard
      .tf-fields-container([data-tf-mode="display/edit/create"])
        label.tf-field-name
        .tf-field-value([data-input-index=1]) */

.tf-card-container .tc-keyboard,
.tf-card-container .tc-eventcatcher {
  display: contents;
}

.tf-card-container {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: 2em 1fr;
  grid-template-areas:
    "id button"
    "field field";
}

.tf-card-id {
  grid-area: id;
  display: grid;
  align-items: center;
  padding-inline-start: .6em;

  font-family: monospace;
  letter-spacing: 1px;
  font-size: .8em;
}

.tf-card-btns {
  grid-area: button;
  display: flex;

  flex-direction: row;
  justify-content: flex-end;
  gap: .5em;
  padding-inline-end: .5em;
}

.tf-fields-container {
  grid-area: field;
  display: grid;
  grid-template-columns: auto 1fr;
}

.tf-field-name {
  display: grid;
  justify-items: right;
  align-items: center;
  padding-inline: .5em;

  font-family: monospace;
  letter-spacing: 1px;
  text-transform: uppercase;
  font-size: .8em;
  font-weight: bold;

}

.tf-field-value {
  display: grid;
  align-items: center;
  padding-inline-start: .5em;
}

.tf-fields-container {
  --accent: var(--tpc-primary);
  --transition: .3s ease;

}
.tf-fields-container[data-tf-mode="create"] {
  background: color-mix(in srgb, var(--tpc-background) 50%, var(--tpc-page-background) 50%);
  padding: 1em;
  
  .tf-field-name {
    color: var(--tpc-primary);
    /* color: color-mix(in srgb, var(--tpc-primary) 80%, transparent); */
  }
}

.tf-fields-container[data-tf-mode="display"] {
  .tf-field-name {
    border-top: 1px dotted var(--tpc-primary);
    border-right: 1px dotted var(--tpc-primary);
  }
  
  .tf-field-value {
    border-top: 1px dotted var(--tpc-primary);
  }
}

.tf-card-container {
  border-width: 1px 1px 1px 3px;
  border-style: solid;
  border-color: var(--tpc-primary);
  border-radius: 3px;
  
  box-shadow: 0 0 3px var(--tpc-primary);
}

.tf-card-list {
  display: flex;
  flex-direction: column;
  gap: 1em;
}