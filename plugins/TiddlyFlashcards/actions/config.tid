title: $:/plugins/uzvg/TiddlyFlashcards/actions/config
code-body: yes

<!-- Copy the edited config value from its store tiddler into the config tiddler. -->

\function get-config-tiddler(item) [[$:/config/TiddlyFlashcards/]addsuffix<item>]
\procedure storeField() store-input

\procedure action.save-config()
\import [[$:/plugins/uzvg/TiddlyFlashcards/actions/notify]]

<$action-setfield
	$tiddler=<<configTiddler>>
	text={{{ [<configTiddler>get<storeField>] }}}/>
<<notify.config-saved>>
\end action.save-config

\procedure tf-save-config-btn(title, tooltip)
<$button actions=<<action.save-config>> tooltip=<<tooltip>>>
  <<title>>
</$button>
\end tf-save-config-btn
