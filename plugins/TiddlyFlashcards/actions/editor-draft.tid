title: $:/plugins/uzvg/TiddlyFlashcards/actions/editor-draft
code-body: yes

<!-- Draft lifecycle of the card editor: write the draft into the data tiddler, or throw it away. -->

<!-- Editors skip setText while focused; bumping the refreshTitle tiddler forces them to re-read the store -->
\function refresh-tiddler() [<storeTiddler>addsuffix[/refresh]]

<!-- Write one note into the data tiddler -->
\widget $action.set-note(dataTiddler,noteId,noteData)
\function get-target-data() [<dataTiddler>get[text]else[]jsonset:json<noteId>,<noteData>format:json[2]]

<$action-setfield
	$tiddler=<<dataTiddler>>
	text=<<get-target-data>>/>
\end

<!-- Throw the draft away and put the cursor back on the first field -->
\procedure action.clear-draft()
\import [[$:/plugins/uzvg/TiddlyFlashcards/actions/editor-input]]

<$action-deletetiddler $tiddler=<<storeTiddler>>/>
<$action-setfield $tiddler=<<refresh-tiddler>> text="1"/>
<<action.focus-input nth="1">>
\end action.clear-draft

<!-- Save a flashcard -->
\procedure action.save-card()
\import [[$:/plugins/uzvg/TiddlyFlashcards/actions/notify]]

\function get-model-name() [<modelTiddler>get[model-name]]
\function get-model-version() [<modelTiddler>get[model-version]]
\function get-field-value() [<storeTiddler>get<currentTiddler>]

\function get-fields-data()
	[<modelTiddler>get[fields-list]enlist-input[]]
	:reduce[<accumulator>jsonset<currentTiddler>,<get-field-value>]
\end get-fields-data

\function get-note-data()
	[[]jsonset:json[fields],<get-fields-data>]
	+[jsonset[modelName],<get-model-name>]
\end get-note-data

\function get-invalid-fields()
	[<modelTiddler>get[required-fields]]
	:else[<modelTiddler>get[fields-list]]
	:and[enlist-input[]]
	:filter[<storeTiddler>!has<currentTiddler>]
\end get-invalid-fields

<!-- In edit mode the card id was recorded when the edit button was clicked;
     in create mode the note id is the creation timestamp of the store tiddler. -->
\function get-note-id()
	[<stateTiddler>get[card-index]]
	:else[<storeTiddler>get[created]format:date[YYYY0MM0DD0hh0mm0ss0XXX]]
\end get-note-id

<% if [function[get-invalid-fields]] %>
	<<notify.invalid-fields>>
<% else %>
	<!-- Initialize the data tiddler -->
	<% if [<dataTiddler>!is[tiddler]] %>
		<$action-setfield
			$tiddler=<<dataTiddler>>
			type="application/json"
			source=<<storyTiddler>>
			model-version=<<get-model-version>>/>
	<% endif %>

	<$action.set-note
		dataTiddler=<<dataTiddler>>
		noteId=<<get-note-id>>
		noteData=<<get-note-data>>/>

	<<action.clear-draft>>
	<<notify.card-saved>>
<% endif %>
\end action.save-card
