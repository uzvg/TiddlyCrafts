title: $:/plugins/uzvg/TiddlyFlashcards/actions/notify
code-body: yes

<!-- Notifications. -->

\procedure notify.invalid-fields()
<$action-sendmessage
	$message="tm-notify"
	$param="$:/plugins/uzvg/TiddlyFlashcards/templates/notify-invalid-fields"/>
\end notify.invalid-fields

\procedure notify.card-saved()
<$action-sendmessage
	$message="tm-notify"
	$param="$:/plugins/uzvg/TiddlyFlashcards/templates/notify-card-saved"/>
\end notify.card-saved

\procedure notify.config-saved()
<$action-sendmessage
	$message="tm-notify"
	$param="$:/plugins/uzvg/TiddlyFlashcards/templates/notify-config-saved"/>
\end notify.config-saved
