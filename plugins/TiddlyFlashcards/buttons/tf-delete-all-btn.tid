title: $:/plugins/uzvg/TiddlyFlashcards/buttons/tf-delete-all-btn
code-body: yes
tags: $:/tags/TFListHeaderBtns
order: 3

\procedure tf-delete-all-btn()

\procedure delete-all-actions()
<$action-confirm $message="Do you wish to delete all flashcards of the currentTiddler?">
    <$action-deletetiddler $tiddler=<<dataTiddler>>/>
</$action-confirm>>
\end delete-all-actions

<$button
    actions=<<delete-all-actions>>
    tooltip="Delete all flashcards of the current tiddler"
    class="tc-btn-invisible">
    <$transclude $tiddler="$:/core/images/delete-button"/>
</$button>
\end

<<tf-delete-all-btn>>