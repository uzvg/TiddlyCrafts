title: $:/plugins/uzvg/TiddlyFlashcards/Procedures/tf-card-actions
code-body: yes

<!-- ---------------- focus on nth input ---------------- -->
\procedure action.focus-nth-input(nth)
<$let
	selector-pattern="""[data-tiddler-title="$(storyTiddler)$"] [data-input-index="$(nth)$"] textarea"""
	focus-selector={{{ [<selector-pattern>substitute[]] }}}>
	<$action-sendmessage
		$message="tm-focus-selector"
		$param=<<focus-selector>>
		focusVisible="true"
		preventScroll="true"/>
	<!-- Debug action
	<$action-log $$message="Debug" focus-selector=<<focus-selector>>/> -->
</$let>
\end action.focus-nth-input

<!-- Save input index when click on the textarea  -->
\procedure action.click-input()
<$action-setfield $tiddler=<<stateTiddler>> focus-index=<<dom-data-input-index>>/>
\end action.click-input

<!-- ---------------- switch to next tab ---------------- -->
\procedure action.switch-next-tab()
<%if [<mode>match[create]] %>
	<$let
		get-tabs-list="[all[tiddlers+shadows]tag[$:/tags/TFModels]!is[draft]sort[order]]"
		nextTab={{{ [subfilter<get-tabs-list>after<modelTiddler>] }}}>
		<%if [<nextTab>!is[blank]] %>
			<$action-setfield $tiddler=<<stateTiddler>> text=<<nextTab>> focus-index="1"/>
		<% else %>
			<<action.focus-nth-input nth="1">>
		<% endif %>

	</$let>
<% endif %>
\end action.switch-next-tab

<!-- ---------------- switch to previous tab ---------------- -->
\procedure action.switch-previous-tab()
<%if [<mode>match[create]] %>
	<$let
		get-tabs-list="[all[tiddlers+shadows]tag[$:/tags/TFModels]!is[draft]sort[order]]"
		previousTab={{{ [subfilter<get-tabs-list>before<modelTiddler>] }}}>
		<%if [<previousTab>!is[blank]] %>
			<$action-setfield $tiddler=<<stateTiddler>> text=<<previousTab>> focus-index="1"/>
		<% else %>
			<<action.focus-nth-input nth="1">>
		<% endif %>
	</$let>
<% endif %>
\end action.switch-previous-tab

<!-- ---------------- focus on next input ---------------- -->
\procedure action.focus-next-input()
<$let
	inputCount={{{ [<modelTiddler>get[fields-list]enlist-input[]count[]] }}}
	currentIndex={{{ [<stateTiddler>get[focus-index]else[1]] }}}
	nextIndex={{{ [<currentIndex>add[1]compare:number:lt<inputCount>else<inputCount>] }}}>
	<!-- <$action-log $$message="Debug"
		currentIndex=<<currentIndex>>
		nextIndex=<<nextIndex>>
		stateTiddler=<<stateTiddler>>
		default=<<default>>
		state={{{ [<stateTiddler>get[text]] }}}/> -->
		<!-- Save default tab -->
	<%if [<stateTiddler>!is[tiddler]] %>
		<$action-setfield $tiddler=<<stateTiddler>> text=<<default>>/>
	<% endif %>
	<%if [<currentIndex>compare:number:ne<nextIndex>] %>
		<$action-setfield $tiddler=<<stateTiddler>> focus-index=<<nextIndex>>/>
	<% endif %>
	<<action.focus-nth-input nth=<<nextIndex>>>>
</$let>
\end action.focus-next-input

<!-- ---------------- focus on previous input ---------------- -->
\procedure action.focus-previous-input()
<$let
    inputCount={{{ [<modelTiddler>get[fields-list]enlist-input[]count[]] }}}
	currentIndex={{{ [<stateTiddler>get[focus-index]] }}}
    previousIndex={{{ [<currentIndex>subtract[1]compare:number:gt[1]else[1]] }}}>
	<%if [<stateTiddler>!is[tiddler]] %>
		<$action-setfield $tiddler=<<stateTiddler>> text=<<default>>/>
	<% endif %>
	<%if [<currentIndex>compare:number:ne<previousIndex>] %>
		<$action-setfield $tiddler=<<stateTiddler>> focus-index=<<previousIndex>>/>
	<% endif %>
	<<action.focus-nth-input nth=<<previousIndex>>>>
</$let>
\end action.focus-previous-input

<!-- Action to set tiddlywiki flascards note field value -->
\widget action.set-note(dataTiddler,noteId,noteData)
\function get-target-data() [<dataTiddler>get[text]else[]jsonset:json<noteId>,<noteData>format:json[2]]

<$action-setfield
    $tiddler=<<dataTiddler>>
    text=<<get-target-data>>/>
\end action.set-note

<!-- action to delete storeTiddler -->
\procedure action.delete-store()
<$action-deletetiddler $tiddler=<<storeTiddler>>/>
\end action.delete-store

<!-- ---------------- actions to create a new flascard ---------------- -->
\procedure action.new-card()

\import [[$:/plugins/uzvg/Procedures/tf-card-notifier]]
\function get-model-name() [<currentTab>get[model-name]]
\function get-model-version() [<currentTab>get[model-version]]
\function get-field-value() [<storeTiddler>get<currentTiddler>]

\function get-fields-data()
	[<currentTab>is[tiddler]]
	+[get[fields-list]]
	+[enlist-input[]]
	:reduce[<accumulator>jsonset<currentTiddler>,<get-field-value>]
\end get-fields-data

\function get-note-data()
	[[]jsonset:json[fields],<get-fields-data>]
	+[jsonset[modelName],<get-model-name>]
\end get-note-data

\function get-invalid-fields()
	[<currentTab>get[required-fields]]
	:else[<currentTab>get[fields-list]]
	:and[enlist-input[]]
	:filter[<storeTiddler>!has<currentTiddler>]
\end get-invalid-fields

\function get-note-id() [<storeTiddler>get[created]format:date[YYYY0MM0DD0hh0mm0ss0XXX]]

<!-- ------------------------------If reqired fields are all non-empty------------------------------ -->
<% if [function[get-invalid-fields]] %>
    <<notifier.invalid-fields>>
<% else %>
	<!-- Initialize datatTiddler -->
	<% if [<dataTiddler>!is[tiddler]] %>
		<$action-setfield
			$tiddler=<<dataTiddler>>
			type="application/json"
			source=<<storyTiddler>>
			model-version=<<get-model-version>>/>
	<% endif %>

	<!-- Create Flashcard -->
	<$action.set-note
		dataTiddler=<<dataTiddler>>
		noteId=<<get-note-id>>
		noteData=<<get-note-data>>/>

	<<action.delete-store>>
	<<notifier.new-card>>
<% endif %>
\end action.new-card