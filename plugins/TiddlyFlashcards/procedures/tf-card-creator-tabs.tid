title: $:/plugins/uzvg/TiddlyFlashcards/Procedures/tf-card-creator-tabs
code-body: yes

\procedure tf-card-creator-tabs()
<$let
    tabsId={{{ [<storyTiddler>get[created]] }}}
    tabsList="[tag[$:/tags/TFCardCreator]!is[draft]sort[order]]"
    default={{{ [subfilter<tabsList>first[]] }}}>
    template="$:/plugins/uzvg/templates/TFEditorTemplate"
    explicitStateTiddler={{{ [[$:/state/tf-creator-tabs/]addsufix<tabsId>] }}}>

    <$transclude $variable="tabs"
        tabsList=<<tabsList>>
        default=<<default>>
        template="$:/plugins/uzvg/TiddlyFlashcards/templates/TFCreatorTemplate"
        explicitState=<<explicitStateTiddler>>/>

</$let>
\end