title: $:/plugins/uzvg/TiddlyFlashcards/Procedures/tf-card-notifier
code-body: yes

<!-- send notifications if has empty fields -->
\procedure notifier.invalid-fields()
<$action-sendmessage
	$message="tm-notify"
	$param="$:/plugins/uzvg/TiddlyFlashcards/templates/invalid-field-notify"/>
\end notifier.invalid-fields

<!-- send notifications when card created done -->
\procedure notifier.save-card()
<$action-sendmessage
	$message="tm-notify"
	$param="$:/plugins/uzvg/TiddlyFlashcards/templates/save-card-notify"/>
\end notifier.save-card