title: $:/plugins/uzvg/TiddlyFlashcards/Procedures/tf-reveal-editor
code-body: yes

\procedure tf-card-btns()
<div class="tf-card-btns">
  <% if [<storeTiddler>is[tiddler]] %>
    <$list filter="[all[tiddlers+shadows]tag[$:/tags/TFBtns]tf-mode[edit]sort[order]]">
      <$transclude $tiddler=<<currentTiddler>>/>
    </$list>
  <% else %>
    <$list filter="[all[tiddlers+shadows]tag[$:/tags/TFBtns]tf-mode[display]sort[order]]">
      <$transclude $tiddler=<<currentTiddler>>/>
    </$list>
  <% endif %>
</div>
\end tf-card-btns

\procedure tf-card-display(cardId)
\import [all[tiddlers+shadows]tag[$:/tags/TFTransformer/ForTW]]

<div class="tf-fields-container" data-tf-mode="display">
  <$list filter="[<dataTiddler>get[text]jsonindexes<cardId>,[fields]reverse[]] -[[Add Reverse]]" variable="currentField">
    <$let fieldValue={{{ [<dataTiddler>get[text]jsonget<cardId>,[fields],<currentField>] }}}>
      <%if [<fieldValue>!is[blank]] %>
        <label class="tf-field-name">
          <<currentField>>
        </label>
        <div class="tf-field-value">
          <$transclude $variable="fieldValue" $mode="block">>
        </div>
      <% endif %>
    </$let>
  </$list>
</div>
\end tf-card-display

\procedure tf-reveal-editor(cardId)
\whitespace trim

\import [[$:/plugins/uzvg/TiddlyFlashcards/Procedures/tf-card-editor]]

<div
  class="tf-card-container"
  data-card-index=`$(cardId)$`
  data-card-status=`$(cardStatus)$`>
  <div class="tf-card-id">
    <<cardId>>
  </div>

  <<tf-card-btns>>

  <%if [<storeTiddler>is[tiddler]] %>
    <<tf-card-editor
      modelTiddler=<<modelTiddler>>
      storeTiddler=<<storeTiddler>>
      stateTiddler=<<stateTiddler>>
      dataTiddler=<<dataTiddler>>
      mode="edit">>
  <% else %>
    <<tf-card-display cardId=<<cardId>>>>
  <% endif %>
</div>
\end tf-reveal-editor