title: $:/plugins/uzvg/TiddlyFlashcards/Procedures/tf-store-actions
code-body: yes

<!-- Editors skip setText while focused; bumping the refreshTitle tiddler forces them to re-read the store -->
\function refreshTiddler() [<storeTiddler>addsuffix[/refresh]]

<!-- ---------------- focus on nth input ---------------- -->
\procedure action.focus-nth-input(nth)
<!-- If in the edit mode -->
<%if [<stateTiddler>get[card-index]!is[blank]] %>
	<$action-sendmessage
		$message="tm-focus-selector"
		$param=`.tf-card-container[data-card-index="$(condition)$"] [data-input-index="$(nth)$"] :is(input, textarea)`
		focusVisible="true"
		preventScroll="true"/>
<!-- Else in the create mode -->
<% else %>
	<$action-sendmessage
		$message="tm-focus-selector"
		$param=`[data-tiddler-title="$(storyTiddler)$"] .tf-fields-container[data-tf-mode="create"] [data-input-index="$(nth)$"] :is(input, textarea)`
		focusVisible="true"
		preventScroll="true"/>
<!--
	<$action-log
		$$message="Debug info:"
		selector=`[data-tiddler-title="$(storyTiddler)$"] .tf-fields-container[data-tf-mode="create"] [data-input-index=$(nth)$] textarea`/>
-->
<% endif %>
\end action.focus-nth-input

<!-- action to delete storeTiddler -->
\procedure action.delete-store()
<$action-deletetiddler $tiddler=<<storeTiddler>>/>
<$action-setfield $tiddler=<<refreshTiddler>> text="1"/>
<<action.focus-nth-input nth="1">>
\end action.delete-store
