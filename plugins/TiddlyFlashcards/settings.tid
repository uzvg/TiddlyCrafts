title: $:/plugins/uzvg/TiddlyFlashcards/settings
tags: $:/tags/ControlPanel/SettingsTab
caption: TiddlyFlashcards

<!-- Settings:
    1. Tiddlyflashcards panel display filter
    2. DeckMapping rules
    3. TagMapping rules
 -->

\function tf-config(suffix) [[$:/config/TiddlyFlashcards/]addsuffix<suffix>]
\function configTiddler() [[$:/config/TiddlyFlashcards/]addsuffix<suffix>]
\function storeTiddler() [<configTiddler>addsuffix[-store]]

\procedure save-config-btn()
  <$button actions="""<$action-setfield $tiddler=<<configTiddler>> text={{{ [<storeTiddler>get[text]] }}}>""">
    save
  </$button>
\end save-config-btn

<table class="tc-max-width tc-edit-max-width tc-first-col-min-width">
    <tr>
      <$let suffix="DisplayFilter">
        <td>
          <$link to=<<configTiddler>> tooltip="Filter expression that determines which tiddlers display the TiddlyFlashcards panel.">
              Display Filter
          </$link>
        </td>
        <td>
            <$edit class="tc-edit-texteditor" tiddler=<<storeTiddler>> autoHeight="yes"/>
            <span class="tc-flex tc-flex-row" style="justify-content:flex-end;"> <<save-config-btn>> </span>
        </td>
      </$let>
    </tr>
    <tr>
        <td>
            <$link to=<<tf-config "DeckMappingRules">> tooltip="Rules that determine which Anki deck the cards from each tiddler are assigned to.">
                DeckMapping rules
            </$link>
        </td>
        <td>
            <$edit class="tc-edit-texteditor" tiddler=<<tf-config "DeckMappingRules">> autoHeight="yes"/>
        </td>
    </tr>
    <tr>
        <td>
            <$link to=<<tf-config "TagMappingRules">> tooltip="Rules that determine which tags are applied to cards from each tiddler.">
                TagMapping rules
            </$link>
        </td>
        <td>
            <$edit class="tc-edit-texteditor" tiddler=<<tf-config "TagMappingRules">> autoHeight="yes"/>
        </td>
    </tr>
    <tr>
    </tr>
        <td>
            <$link to=<<tf-config "CardListSize">> tooltip="The cards number of the cards list">
                CardListSize
            </$link>
        </td>
        <td>
            <$edit-text tiddler=<<tf-config "CardListSize">> type="number" tag="input"/><p/>
        </td>
</table>
