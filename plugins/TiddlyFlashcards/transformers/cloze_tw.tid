\procedure cloze(id,text)
<span class="tf-cloze" data-cloze-id=`$(id)$`>
    <$transclude $variable="text" $mode="inline"/>
<span>
\end

\procedure clz(text,id:c1) <<cloze id=<<id>> text=<<text>>>>
\procedure c1(text) <<cloze id="c1" text=<<text>>>>
