\procedure clz(id,text)
\whitespace trim
\rules except transcludeinline transcludeblock
<$wikify name="wikifiedText" text=<<text>> output="html" mode="inline">
  {{<<id>>::<<wikifiedText>>}}
</$wikify>
\end clz

\procedure c1(text) <<clz id:"c1" text=<<text>>>>
