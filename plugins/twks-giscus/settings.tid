title: $:/plugins/uzvg/twks-giscus/settings
caption: settings

<!-- twks-giscus config tiddler for saving configs -->
\procedure configTiddler() $:/config/twks-giscus

<!-- Generate options from the optionsList -->
\procedure list-selector(tiddler,index,placeholder,optionsList,default,class)
<$select
	tiddler=<<tiddler>>
	index=<<index>>
	default=<<default>>
	class=<<class>>>
	<option disabled><<placeholder>></option>
	<$list filter="[enlist<optionsList>]" variable="option">
		<option> <<option>> </option>
	</$list>
</$select
\end

<!-- Generate options from the dataTiddler -->
\procedure data-selector(dataTiddler,placeholder,tiddler,index,default,class)
\function get-option-title() [<dataTiddler>getindex<option>]
<$select
	tiddler=<<tiddler>>
	index=<<index>>
	default=<<default>>
	class=<<class>>>
	<option value=<<default>> disabled><<placeholder>></option>
	<$list filter="[<dataTiddler>indexes[]]" variable="option">
		<option value=<<option>>>
			<<get-option-title>>
		</option>
	</$list>
</$select>
\end

<!-- Giscus language selector -->
\procedure lang-selector()
<$transclude $variable="data-selector"
	dataTiddler="$:/plugins/uzvg/twks-giscus/data/languages"
	placeholder="Pick a language"
	default="Pick a language"
	tiddler=<<configTiddler>>
	index="lang"/>
\end

<!-- Giscus theme selector -->
\procedure theme-selector(index)
<$transclude $variable="data-selector"
	dataTiddler="$:/plugins/uzvg/twks-giscus/data/themes"
	placeholder="Pick a theme"
	default="Pick a theme"
	tiddler=<<configTiddler>>
	index=<<index>>/>
\end

<!-- Discuss category selector -->
\procedure category-selector()
<$transclude $variable="list-selector"
	tiddler=<<configTiddler>>
	index="category"
	placeholder="Pick a category"
	default="Pick a category"
	optionsList="Announcements General Ideas Polls Q&A [[Show and tell]]"/>
\end

<!-- Checkable items -->
\procedure checkable-items()
<li>
  <$checkbox
    tiddler=<<configTiddler>>
    index="reactions-enable"
    checked="1"
    unchecked="0"
    default="1">
    Enable reactions for the main post
  </$checkbox>
</li>

<li>
  <$checkbox
    tiddler=<<configTiddler>>
    index="emit-metadata"
    checked="1"
    unchecked="0"
    default="1">
    Emit discussion metadata
  </$checkbox>
</li>

<li>
  <$checkbox
    tiddler=<<configTiddler>>
    index="input-position"
    checked="top"
    unchecked="bottom"
    default="top">
    Place the comment box above the comments
  </$checkbox>
</li>
\end


