title: $:/uzvg/FieldValues/images/TiddlyCrafts
tags: FieldValues

\procedure tiddlers-prefix() https://images.uzvg.site/TiddlyCrafts/tiddlers/images/
\procedure plugins-prefix() https://images.uzvg.site/TiddlyCrafts/plugins

\function get-image-url()
  [<currentTiddler>prefix[$:/plugins/uzvg/]]
  :then[<currentTiddler>search-replace[$:/plugins/uzvg],<plugins-prefix>]
  :else[<tiddlers-prefix>addsuffix<currentTiddler>]
  :and[encodeuri[]]
\end
<<get-image-url>>
