title: $:/uzvg/FieldValues/images/TiddlyCrafts
tags: FieldValues

\procedure base-url() https://images.uzvg.site/TiddlyCrafts/
\function tiddlers-prefix() [<base-url>addsuffix[tiddlers/]]
\function plugins-prefix() [<base-url>addsuffix[plugins]]

\function tiddlers-image-url()
  [<currentTiddler>]
  :cascade[[$:/config/FileSystemPaths]get[text]]
  +[addprefix<tiddlers-prefix>]
\end tiddlers-image-url

\function get-image-url()
  [<currentTiddler>prefix[$:/plugins/uzvg/]]
  :then[<currentTiddler>search-replace[$:/plugins/uzvg],<plugins-prefix>]
  :else[<tiddlers-image-url>]
  :and[encodeuri[]]
\end
<<get-image-url>>
