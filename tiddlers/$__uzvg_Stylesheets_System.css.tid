<!-- The current file mainly contains changes to the system style -->

<!-- Disable font ligature feature globally -->
<!--
body {
  font-feature-settings: "liga" 0, "clig" 0;
}

-->

<!-- Gradient heading within tiddler body -->
.tc-tiddler-frame :is(h1, h2, h3):not(.tc-title) {
  font-weight: bold;
  font-family: <<serif-font>>;
  background-image: linear-gradient(
    to right,
    <<color muted-foreground>>,
    transparent);
  background-size: 100% 1px;
  background-repeat: no-repeat;
  background-position: left bottom;
  padding-bottom: 0.2em;
}

<!-- Don't apply gradient heading for plugin info page -->
.tc-plugin-info :is(h1, h2, h3) {
  background: none;
  font-family: inherit;
}

<!-- Make titlebar buttons autohide -->
.tc-tiddler-controls button {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.tc-tiddler-frame:hover .tc-tiddler-controls button,
.tc-tiddler-frame:focus-within .tc-tiddler-controls button {
  opacity: 1;
  pointer-events: auto;
}

<!-- Use Serif font for blockquote -->
.tc-tiddler-body blockquote {
  font-family: <<serif-font>>;
  line-height: 1.6;
}

<!-- Use bold Serif for tiddler title -->
.tc-tiddler-title .tc-title {
  font-family: <<serif-font>>;
  font-weight: 600;
}

<!-- Reduce spacing between heading and tabs widget -->
.tc-tiddler-body h2 + .tc-tab-set {
  margin-top: 0em;
}

<!-- Draggable plugin-library link -->
<!-- a. prefix to outrank a.tc-tiddlylink from the vanilla theme -->
a.crft-lib {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5em 1.25em;
  border-radius: 0.6em;
  background: <<color primary>>;
  color: <<color background>>;
	font-family: serif;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  cursor: grab;
  user-select: none;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

a.crft-lib:hover {
  color: <<color background>>;
  text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
}

a.crft-lib:active,
a.crft-lib.tc-dragging {
  color: <<color background>>;
  cursor: grabbing;
  transform: scale(0.97);
}