{
  "name": "tiddlycrafts",
  "description": "Basic client-server edition",
  "plugins": [
    "tiddlywiki/tiddlyweb",
    "tiddlywiki/filesystem",
    "tiddlywiki/highlight",
    "tiddlywiki/katex",
    "tiddlywiki/codemirror",
    "tiddlywiki/pluginlibrary",
    "tiddlywiki/codemirror-autocomplete",
    "tiddlywiki/codemirror-closebrackets",
    "tiddlywiki/codemirror-closetag",
    "tiddlywiki/codemirror-trailingspace",
    "tiddlywiki/codemirror-mode-css",
    "tiddlywiki/codemirror-search-replace",
    "thirdparty/relink",
    "thirdparty/relink-fieldnames",
    "thirdparty/relink-markdown",
    "thirdparty/relink-titles",
    "thirdparty/relink-variables"
  ],
  "themes": [
    "tiddlywiki/vanilla",
    "tiddlywiki/snowwhite"
  ],
  "languages": [
    "zh-Hans"
  ],
  "build": {
    "index": [
      "--render",
      "$:/core/save/all",
      "index.html",
      "text/plain"
    ],
    "prune": [
      "--deletetiddlers",
      "[prefix[$:/state/]]",
      "--deletetiddlers",
      "[prefix[$:/Storage/]]",
      "--deletetiddlers",
      "[prefix[$:/temp/]]",
      "--deletetiddlers",
      "[is[draft]]",
      "--deletetiddlers",
      "[all[tiddlers+shadows]prefix[$:/plugins/]!author[uzvg]]"
    ],
    "images": [
      "--setfield",
      "[all[tiddlers+shadows]is[image]!type[image/svg+xml]!has[_canonical_uri]]",
      "text",
      "",
      "text/plain",
      "--setfield",
      "[all[tiddlers+shadows]is[image]!type[image/svg+xml]!has[_canonical_uri]]",
      "_canonical_uri",
      "$:/uzvg/FieldValues/image-urls/TiddlyCrafts",
      "text/plain"
    ],
    "fields": [
      "--setfield",
      "[[$:/config/SaverFilter]]",
      "text",
      "",
      "text/plain",
      "--setfield",
      "[[$:/core/ui/Buttons/import]]",
      "tags",
      "",
      "text/plain",
      "--setfield",
      "[[$:/core/ui/Buttons/refresh]]",
      "tags",
      "",
      "text/plain",
      "--setfield",
      "[[$:/core/ui/Buttons/new-tiddler]]",
      "tags",
      "",
      "text/plain",
      "--setfield",
      "[[$:/core/ui/Buttons/save-wiki]]",
      "tags",
      "",
      "text/plain",
      "--setfield",
      "[[$:/config/Navigation/UpdateHistory]]",
      "text",
      "$:/uzvg/FieldValues/values/yes",
      "text/plain",
      "--setfield",
      "[[$:/DefaultTiddlers]]",
      "text",
      "$:/uzvg/FieldValues/values/home",
      "text/plain"
    ],
    "library": [
      "--makelibrary",
      "$:/UpgradeLibrary",
      "--savelibrarytiddlers",
      "$:/UpgradeLibrary",
      "[prefix[$:/plugins/]author[uzvg]]",
      "recipes/library/tiddlers/",
      "$:/UpgradeLibrary/List",
      "--savetiddler",
      "$:/UpgradeLibrary/List",
      "recipes/library/tiddlers.json",
      "--rendertiddler",
      "$:/plugins/tiddlywiki/pluginlibrary/library.template.html",
      "index.html",
      "text/plain"
    ],
    "flashcards": [
      "--render",
      "$:/plugins/uzvg/TiddlyFlashcards/templates/tf-render-template",
      "flashcards.json",
      "text/plain"
    ],
    "static": [
      "--render",
      "$:/core/templates/static.template.html",
      "static.html",
      "text/plain",
      "--render",
      "$:/core/templates/alltiddlers.template.html",
      "alltiddlers.html",
      "text/plain",
      "--render",
      "[!is[system]]",
      "[encodeuricomponent[]addprefix[static/]addsuffix[.html]]",
      "text/plain",
      "$:/core/templates/static.tiddler.html",
      "--render",
      "$:/core/templates/static.template.css",
      "static/static.css",
      "text/plain"
    ]
  }
}
